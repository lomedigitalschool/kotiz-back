{
  "name": "kotiz-back",
  "version": "1.0.0",
  "description": "Backend API pour l'application Kotiz développée par Lome Digital School",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --max-old-space-size=400 --optimize-for-size src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --testEnvironment=node",
    "test:admin": "jest src/tests/admin.test.js --testEnvironment=node",
    "test:adminjs": "node src/tests/adminjs-test-suite.js",
    "test:adminjs-integration": "jest src/tests/adminjs-integration.test.js --testEnvironment=node",
    "test:adminjs-security": "jest src/tests/adminjs-security.test.js --testEnvironment=node",
    "test:adminjs-routes": "jest src/tests/adminjs-routes.test.js --testEnvironment=node",
    "test:adminjs-session": "jest src/tests/adminjs-session.test.js --testEnvironment=node",
    "test:watch": "jest --watch --testEnvironment=node",
    "create-admin": "node scripts/createAdmin.js",
    "create-secure-admin": "node src/scripts/create-secure-admin.js",
    "test-routes": "node test-routes.js",
    "debug-adminjs": "node debug-adminjs.js",
    "fix-server": "node fix-server.js all",
    "test-complete": "node test-complete.js",
    "test-firebase": "node test-firebase.js",
    "audit:adminjs": "node -e \"console.log('📋 Voir AUDIT_ADMINJS_REPORT.md pour le rapport complet')\"",
    "security:adminjs": "node -e \"console.log('🔒 Voir ADMINJS_SECURITY_FIXES.js pour les corrections')\"",
    "render-postbuild": "echo '🚀 Build terminé pour Render'"
  },
  "dependencies": {
    "@adminjs/design-system": "^4.0.5",
    "@adminjs/express": "^6.1.1",
    "@adminjs/sequelize": "^4.1.1",
    "adminjs": "^7.6.1",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.0",
    "cloudinary": "^1.41.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "jsdom": "^27.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "multer-storage-cloudinary": "^4.0.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-select": "^5.10.2",
    "recharts": "^3.2.1",
    "sequelize": "^6.32.1",
    "socket.io": "^4.8.1",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "globals": {
      "NODE_OPTIONS": "--experimental-vm-modules"
    }
  },
  "keywords": [
    "kotiz",
    "backend",
    "api",
    "express"
  ],
  "author": "Lome Digital School",
  "license": "MIT"
}
