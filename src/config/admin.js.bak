// Helper pour formater les valeurs en chaînes de caractères
const formatValue = (value) => {
  if (value === null || value === undefined) return '';
  if (typeof value === 'object' && value.hasOwnProperty('label')) return value.label;
  if (typeof value === 'object' && value.hasOwnProperty('value')) return value.value;
  if (typeof value === 'object') return JSON.stringify(value);
  return String(value);
};

  // Configuration AdminJS
  const adminOptions = {
    componentLoader,
    databases: [],
    bundler: false,
    renderValue: (value) => formatValue(value),
    assets: {
      styles: [],
      scripts: []
