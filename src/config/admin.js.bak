            icon: 'Check',
            isVisible: ({ record }) => !record.paramValues?.read,
            component: false,
            handler: async (request, response, context) => {
              const { record, currentAdmin } = context;

              if (!currentAdmin || currentAdmin.role !== 'admin') {
                return {
                  record: record.toJSON(),
                  msg: 'Accès non autorisé'
                };
              }

              try {
                const [updateCount] = await Notification.update(
                  { read: true },
                  { where: { id: record.id } }
                );

                const updatedRecord = await Notification.findByPk(record.id);
                return {
                  record: updatedRecord.toJSON(),
                  msg: 'Notification marquée comme lue',
                  notice: {
                    message: 'Notification marquée comme lue',
                    type: 'success'
                  }
                };
              } catch (error) {
                console.error('Erreur markAsRead:', error);
                return {
                  record: record.toJSON(),
                  msg: 'Erreur lors du marquage'
                };
              }
            }
          }
