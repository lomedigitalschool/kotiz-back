            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25000,\n  \"reason\": \"Retrait des fonds collectés pour l'événement\",\n  \"paymentMethodId\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/pulls/:id/withdraw",
              "host": ["{{base_url}}"],
              "path": ["pulls", ":id", "withdraw"],
              "variable": [
                {
                  "key": "id",
                  "value": "cagnotte-id"
                }
              ]
            },
            "description": "Retirer des fonds d'une cagnotte. Conditions requises: 1) Être propriétaire, 2) KYC approuvé, 3) Objectif atteint OU deadline dépassée OU cagnotte fermée"
          },
          "response": []
        },
