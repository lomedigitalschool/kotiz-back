    {
      "name": "Complete User Journey",
      "item": [
        {
          "name": "🚀 1. Firebase Authentication (Get ID Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=YOUR_FIREBASE_API_KEY",
              "protocol": "https",
              "host": ["identitytoolkit", "googleapis", "com"],
              "path": ["v1", "accounts:signInWithPassword"],
              "query": [
                {
                  "key": "key",
                  "value": "YOUR_FIREBASE_API_KEY"
                }
              ]
            },
            "description": "Obtenir un Firebase ID Token (nécessaire pour tous les appels API). Remplacer YOUR_FIREBASE_API_KEY par votre clé API Firebase."
          },
          "response": []
        },
        {
          "name": "👤 2. Sync Firebase User (Auto Create)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/firebase-sync",
              "host": ["{{base_url}}"],
              "path": ["auth", "firebase-sync"]
            },
            "description": "Synchronise l'utilisateur Firebase avec PostgreSQL. Crée automatiquement l'utilisateur s'il n'existe pas."
          },
          "response": []
        },
        {
          "name": "📋 3. Create Cagnotte",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Test Cagnotte Retrait",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Cagnotte pour tester le système de retrait",
                  "type": "text"
                },
                {
                  "key": "goalAmount",
                  "value": "50000",
                  "type": "text"
                },
                {
                  "key": "currency",
                  "value": "XOF",
                  "type": "text"
                },
                {
                  "key": "deadline",
                  "value": "2025-12-31",
                  "type": "text"
                },
                {
                  "key": "type",
                  "value": "public",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/pulls",
              "host": ["{{base_url}}"],
              "path": ["pulls"]
            },
            "description": "Créer une nouvelle cagnotte pour les tests"
          },
          "response": []
        },
        {
          "name": "💰 4. Make Contribution",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000,\n  \"message\": \"Test contribution pour retrait\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pulls/{{cagnotte_id}}/contribute",
              "host": ["{{base_url}}"],
              "path": ["pulls", "{{cagnotte_id}}", "contribute"]
            },
            "description": "Faire une contribution pour atteindre l'objectif et permettre le retrait"
          },
          "response": []
        },
        {
          "name": "🔒 5. Close Cagnotte (Optional)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"closed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pulls/{{cagnotte_id}}",
              "host": ["{{base_url}}"],
              "path": ["pulls", "{{cagnotte_id}}"]
            },
            "description": "Fermer la cagnotte manuellement (optionnel si objectif atteint)"
          },
          "response": []
        },
