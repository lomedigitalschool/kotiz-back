{
  "name": "kotiz-back",
  "version": "1.0.0",
  "description": "Backend API pour l'application Kotiz développée par Lome Digital School",
  "type": "module",
  "pnpm": {
    "overrides": {
      "@tiptap/core": "^2.7.0",
      "@tiptap/pm": "^2.7.0"
    }
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node --max-old-space-size=400 --optimize-for-size src/server.js",
    "dev": "nodemon src/server.js",
    "test": "set NODE_ENV=test && set USE_SQLITE_TEST=true && set NODE_OPTIONS=--experimental-vm-modules && npx jest --testEnvironment=node",
    "test:admin": "set NODE_ENV=test && set USE_SQLITE_TEST=true && set NODE_OPTIONS=--experimental-vm-modules && npx jest src/tests/admin.test.js --testEnvironment=node",
    "test:adminjs": "node src/tests/adminjs-test-suite.js",
    "test:adminjs-integration": "npx jest src/tests/adminjs-integration.test.js --testEnvironment=node",
    "test:adminjs-security": "npx jest src/tests/adminjs-security.test.js --testEnvironment=node",
    "test:adminjs-routes": "npx jest src/tests/adminjs-routes.test.js --testEnvironment=node",
    "test:adminjs-session": "npx jest src/tests/adminjs-session.test.js --testEnvironment=node",
    "test:watch": "npx jest --watch --testEnvironment=node",
    "create-admin": "node scripts/createAdmin.js",
    "create-secure-admin": "node src/scripts/create-secure-admin.js",
    "test-routes": "node test-routes.js",
    "debug-adminjs": "node debug-adminjs.js",
    "fix-server": "node fix-server.js all",
    "test-complete": "node test-complete.js",
    "test-firebase": "node test-firebase.js",
    "audit:adminjs": "node -e \"console.log('📋 Voir AUDIT_ADMINJS_REPORT.md pour le rapport complet')\"",
    "security:adminjs": "node -e \"console.log('🔒 Voir ADMINJS_SECURITY_FIXES.js pour les corrections')\""
  },
  "dependencies": {
    "@adminjs/design-system": "4.0.0-beta-v4.18",
    "@adminjs/express": "^6.1.1",
    "@adminjs/mongoose": "^4.0.0",
    "@adminjs/sequelize": "^4.1.1",
    "@adminjs/themes": "^1.0.1",
    "@tiptap/core": "^2.26.1",
    "@tiptap/extension-code-block": "2.26.1",
    "@tiptap/extension-dropcursor": "2.26.1",
    "@tiptap/extension-gapcursor": "2.26.1",
    "@tiptap/extension-history": "2.26.1",
    "@tiptap/extension-horizontal-rule": "2.26.1",
    "@tiptap/pm": "^2.26.1",
    "@tiptap/starter-kit": "2.26.1",
    "adminjs": "^7.8.17",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.0",
    "cloudinary": "^1.41.3",
    "connect-mongo": "^5.1.0",
    "connect-pg-simple": "^10.0.0",
    "connect-session-sequelize": "^8.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "i18n": "^0.15.3",
    "jsdom": "^27.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "multer-storage-cloudinary": "^4.0.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.0",
    "react-select": "^5.10.2",
    "recharts": "^3.2.1",
    "sequelize": "^6.32.1",
    "socket.io": "^4.8.1",
    "styled-components": "^6.1.19",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/runtime": "^7.28.4",
    "babel-jest": "^30.2.0",
    "cross-env": "^10.1.0",
    "csv-parse": "^6.1.0",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "sqlite3": "^5.1.7",
    "supertest": "^6.3.4",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "kotiz",
    "backend",
    "api",
    "express"
  ],
  "author": "Lome Digital School",
  "license": "MIT"
}
