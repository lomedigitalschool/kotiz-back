{
  "info": {
    "name": "Kotiz API Collection",
    "description": "Collection complète des endpoints de l'API Kotiz avec authentification Firebase, système de retrait automatique, KYC multi-soumissions et endpoints publics (v3.0)",
    "version": "3.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{firebase_id_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
  {
    "key": "base_url",
    "value": "http://localhost:5000/api/v1",
    "type": "string"
  },
    {
      "key": "firebase_id_token",
      "value": "",
      "type": "string",
      "description": "Firebase ID Token obtenu après authentification côté client"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "Token JWT (pour compatibilité avec anciens endpoints)"
    },
    {
      "key": "cagnotte_id",
      "value": "",
      "type": "string",
      "description": "ID de la cagnotte créée pour les tests"
    }
  ],
  "item": [
    {
      "name": "Firebase Authentication",
      "item": [
        {
          "name": "Firebase Sync (Auto User Creation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}",
                "description": "Firebase ID Token from client authentication"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/auth/firebase-sync",
              "host": ["{{base_url}}"],
              "path": ["auth", "firebase-sync"]
            },
            "description": "Synchronise l'utilisateur Firebase avec la base PostgreSQL. Crée automatiquement un utilisateur s'il n'existe pas."
          },
          "response": []
        },
        {
          "name": "Get Current User (Firebase)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Récupère les informations de l'utilisateur connecté via Firebase"
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe Updated\",\n  \"email\": \"john.updated@example.com\",\n  \"phone\": \"+22501020304\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"]
            },
            "description": "Met à jour le profil utilisateur"
          },
          "response": []
        },
        {
          "name": "Update Phone Number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+22501020304\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/update-phone",
              "host": ["{{base_url}}"],
              "path": ["auth", "update-phone"]
            },
            "description": "Met à jour le numéro de téléphone après inscription"
          },
          "response": []
        },
        {
          "name": "Check Admin Access",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/admin-check",
              "host": ["{{base_url}}"],
              "path": ["auth", "admin-check"]
            },
            "description": "Vérifie si l'utilisateur a les droits administrateur"
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Demande de réinitialisation de mot de passe (rate limited)"
          },
          "response": []
        },
        {
          "name": "Send Password Changed Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/send-password-changed-email",
              "host": ["{{base_url}}"],
              "path": ["auth", "send-password-changed-email"]
            },
            "description": "Envoie un email de confirmation après changement de mot de passe"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_id_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Déconnexion utilisateur"
          },
          "response": []
        }
      ]
    },
    {
      "name": "KYC Management",
      "item": [
        {
          "name": "Submit KYC Documents",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "typeSubmission",
                  "value": "PREMIERE_SOUMISSION",
                  "type": "text"
                },
                {
                  "key": "typePiece",
                  "value": "CNI",
                  "type": "text"
                },
                {
                  "key": "numeroPiece",
                  "value": "CNI123456789",
                  "type": "text"
                },
                {
                  "key": "dateExpiration",
                  "value": "2030-12-31",
                  "type": "text"
                },
                {
                  "key": "photoRecto",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "photoVerso",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/kyc/submit",
              "host": ["{{base_url}}"],
              "path": ["kyc", "submit"]
            }
          },
          "response": []
        },
        {
          "name": "Get KYC History",
          "request": {
