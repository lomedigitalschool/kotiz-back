            "url": {
              "raw": "{{base_url}}/pulls/:id",
              "host": ["{{base_url}}"],
              "path": ["pulls", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "cagnotte-id"
                }
              ]
            },
            "description": "Fermer une cagnotte en changeant son statut (active → closed)"
