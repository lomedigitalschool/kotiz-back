        httpOnly: true,
        maxAge: 24 * 60 * 60 * 1000,
        sameSite: 'lax'
      }
    }
  );
  console.log('✅ Routeur AdminJS créé avec authentification');

  return { admin, adminRouter };
};

export default initAdmin;
